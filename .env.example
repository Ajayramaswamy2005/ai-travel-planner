# --- LLM ---
GROQ_API_KEY=

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=

# --- Weather (OpenWeatherMap) ---
WEATHER_API_KEY=

# --- SerpAPI (Google Search) ---
SERPAPI_API_KEY=

# --- Currency (exchangerate.host or open) ---
