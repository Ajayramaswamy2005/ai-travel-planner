# --- LLM ---
GROQ_API_KEY=

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=

# --- Weather (OpenWeatherMap) ---
WEATHER_API_KEY=

# --- SerpAPI (Google Search) ---
SERPAPI_API_KEY=

# --- Currency (exchangerate.host or open) ---
CURRENCY_API_KEY=

# --- App ---
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# When true (or when API keys are missing), tools/LLM return mock data
USE_MOCK_FALLBACK=true

# --- Tools / MCP ---
# local = agents call tools in-process; mcp = agents call tools via the MCP server
TOOL_TRANSPORT=local
# Optional: URL of a running MCP server (streamable HTTP), e.g. http://127.0.0.1:8765/mcp
# When empty and TOOL_TRANSPORT=mcp, the server is spawned over stdio.
MCP_SERVER_URL=

# Simulated latency for mock mode (used by the benchmark)
MOCK_TOOL_LATENCY_MS=10
MOCK_LLM_LATENCY_MS=0
